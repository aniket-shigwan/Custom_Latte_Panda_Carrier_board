	(text "All I2C pins have integrated pull-up resistors on the LattePanda Mu compute module.\nno need to add pull-up resistors on the carrier board."
		(exclude_from_sim no)
		(at 364.49 238.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1815417f-ee43-4803-acb6-79b864513246")
	)
	(text "SPI is only used to connect to the BIOS ROM.\nCannot be used as a general SPI interface."
		(exclude_from_sim no)
		(at 377.19 262.89 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "371c3962-83fd-416d-be1e-600dac38d112")
	)
	(text "USB2_P6 is reserved for TypeC PD Controller\nDO NOT use it as a normal USB"
		(exclude_from_sim no)
		(at 334.01 137.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "55fdaf9b-0a2a-4205-8319-43d54926ad64")
	)
	(text "State Signal\n\n- PWR_LED/PSON: \n  - S0 (Working): HIGH\n  - S3 (Sleeping): LOW\n  - S4 (Hibernation): LOW\n  - S5 (Soft Off): LOW\n\n- SLS_S4_N:\n  - S0 (Working): HIGH\n  - S3 (Sleeping): HIGH\n  - S4 (Hibernation): LOW\n  - S5 (Soft Off): LOW"
		(exclude_from_sim no)
		(at 173.99 49.53 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "5879a226-4bf1-4228-9e82-785f212297e0")
	)
	(text "Debug uart"
		(exclude_from_sim no)
		(at 205.74 67.31 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "72dccba5-31cc-41fa-b86d-88cac76321da")
	)
	(text "DDI/TCP functions are defined by the BIOS firmware, \nCannot be changed in BIOS menu.\n\nBefore starting design, you should choose one of\nthe available BIOS configurations on:\nhttps://github.com/LattePandaTeam/LattePanda-Mu\n\nThe default functions are defined as follows:\n\n- DDIA: eDP 1.4b (the 40Pin connector on the Mu)\n\n- DDIB: HDMI 2.0\n\n- TCP0: HDMI 2.0\n\n- TCP1: USB TypeC (need external PD controller)"
		(exclude_from_sim no)
		(at 17.78 252.73 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left)
		)
		(uuid "b80a266f-6760-4311-9d95-870dd00ec6b3")
	)
	(text "HSIO functions are defined by the BIOS firmware, \nCannot be changed in BIOS menu.\n\nBefore starting design, you should choose one of\nthe available BIOS configurations on:\nhttps://github.com/LattePandaTeam/LattePanda-Mu\nOr contact techsupport for custom your BIOS\n\nThe default functions are defined as follows:\n\n- HSIO0: USB3.2 10Gbps\n- HSIO1: USB3.2 10Gbps\n- HSIO2: PCIe 3.0 x1\n- HSIO3: PCIe 3.0 x1\n\n- HSIO8: PCIe 3.0 x4 (Lane 0)\n- HSIO9: PCIe 3.0 x4 (Lane 1)\n- HSIO10: PCIe 3.0 x4 (Lane 2)\n- HSIO11: PCIe 3.0 x4 (Lane 3)\n\n- HSIO6: PCIe 3.0 x1"
		(exclude_from_sim no)
		(at 19.05 138.43 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left)
		)
		(uuid "bb2f2712-4e14-4182-87ca-057fdf0c40d1")
	)
	(text "Lite Carrier has no second BIOS ROM chip welded on the board.\n~{BIOS_SEL} pull up to 3.3V to select ROM of LattePanda Mu compute module."
		(exclude_from_sim no)
		(at 377.19 270.51 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "da8e491a-ccd3-4d23-9765-e28ee3d7e62b")
	)
